-- ============================================================
-- 行级安全（RLS）兜底策略（模板）
-- 作用：即使有人拿到浏览器里公开的 anon key 直接调用
-- Supabase REST API，也无法绕过应用层增删改数据。
--
-- ⚠️ 使用方法：
--   1. 复制本文件为 supabase/rls.sql（已被 .gitignore 忽略，不会入库）
--   2. 把下方 your-admin@example.com 替换成你自己的管理员邮箱（可多个，逗号分隔）
--   3. 在 Supabase Dashboard → SQL Editor 整段执行
-- ============================================================

-- ---------- 1. 分类表 ds_categorys ----------
ALTER TABLE public.ds_categorys ENABLE ROW LEVEL SECURITY;

-- 清理该表上所有既有策略，避免旧的宽松策略残留放行匿名写
DO $$
DECLARE pol RECORD;
BEGIN
  FOR pol IN
    SELECT tablename, policyname FROM pg_policies
    WHERE schemaname = 'public' AND tablename = 'ds_categorys'
  LOOP
    EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', pol.policyname, pol.tablename);
  END LOOP;
END $$;

-- 公开可读（首页 / 列表展示需要）
DROP POLICY IF EXISTS "ds_categorys_public_read" ON public.ds_categorys;
CREATE POLICY "ds_categorys_public_read"
  ON public.ds_categorys FOR SELECT
  USING (true);

-- 仅管理员可写
DROP POLICY IF EXISTS "ds_categorys_admin_write" ON public.ds_categorys;
CREATE POLICY "ds_categorys_admin_write"
  ON public.ds_categorys FOR ALL
  USING (auth.jwt() ->> 'email' IN ('your-admin@example.com'))
  WITH CHECK (auth.jwt() ->> 'email' IN ('your-admin@example.com'));

-- ---------- 2. 网站表 ds_websites ----------
ALTER TABLE public.ds_websites ENABLE ROW LEVEL SECURITY;

-- 清理该表上所有既有策略，避免旧的宽松策略残留放行匿名写
DO $$
DECLARE pol RECORD;
BEGIN
  FOR pol IN
    SELECT tablename, policyname FROM pg_policies
    WHERE schemaname = 'public' AND tablename = 'ds_websites'
  LOOP
    EXECUTE format('DROP POLICY IF EXISTS %I ON public.%I', pol.policyname, pol.tablename);
  END LOOP;
END $$;

-- 公开可读（首页 / 列表展示需要）
DROP POLICY IF EXISTS "ds_websites_public_read" ON public.ds_websites;
CREATE POLICY "ds_websites_public_read"
  ON public.ds_websites FOR SELECT
  USING (true);

-- 仅管理员可写
DROP POLICY IF EXISTS "ds_websites_admin_write" ON public.ds_websites;
CREATE POLICY "ds_websites_admin_write"
  ON public.ds_websites FOR ALL
  USING (auth.jwt() ->> 'email' IN ('your-admin@example.com'))
  WITH CHECK (auth.jwt() ->> 'email' IN ('your-admin@example.com'));

-- ============================================================
-- 验证查询（可选）：确认两张表当前策略清单
-- SELECT schemaname, tablename, policyname, cmd FROM pg_policies
